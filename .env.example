# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./private/telegram_session
TELEGRAM_SOURCE_CHATS=@Animehighbo

# Rubpy user-account session name/path (NOT a bot token).
# Provision and test this session privately before enabling live uploads.
RUBIKA_SESSION_NAME=./private/rubika_session
RUBIKA_DESTINATION_GUID=

TELERUBIK_STATE_DB=./data/telerubik.sqlite3
TELERUBIK_DOWNLOAD_DIR=./downloads
TELERUBIK_MAX_FILE_SIZE_MB=500
TELERUBIK_MAX_RETRIES=3
TELERUBIK_RETRY_BASE_SECONDS=2
TELERUBIK_POLL_SECONDS=20
TELERUBIK_LOOKBACK_LIMIT=25
TELEGRAM_ALLOWED_USER_IDS=
TELERUBIK_DRY_RUN=true
